{
  "name": "matoga",
  "version": "2.0.0",
  "description": "材质贴图对比工具 - 本地 Web 服务版（B/S 架构）",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "web": "node server/index.js",
    "web:lan": "node server/index.js --lan",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:smoke": "node test/smoke/api-smoke.mjs && node test/smoke/ws-sync.test.mjs",
    "build:win": "pkg server/index.js --target node18-win-x64 --output dist/matoga-win-x64.exe"
  },
  "keywords": [
    "folder",
    "compare",
    "diff",
    "texture",
    "material",
    "pbr",
    "web"
  ],
  "author": {
    "name": "芝世 (xiongmiaozai)",
    "email": "2720596091@qq.com"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "assets": [
      "web/**/*",
      "node_modules/three/build/three.module.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0"
  }
}
