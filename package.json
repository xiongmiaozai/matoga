{
  "name": "matoga",
  "version": "3.2.0",
  "description": "材质贴图对比工具 - 本地 Web 服务版（B/S 架构）",
  "main": "electron/main.js",
  "workspaces": [
    "server",
    "web",
    "electron"
  ],
  "scripts": {
    "start": "node server/index.js",
    "web": "node server/index.js",
    "web:lan": "node server/index.js --lan",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:smoke": "node test/smoke/run.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,mjs,css,html,json}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{js,mjs,css,html,json}\" --ignore-path .prettierignore",
    "build:win": "pkg server/index.js --target node22-win-x64 --output dist/matoga-win-x64.exe",
    "build:mac": "pkg server/index.js --target node22-macos-arm64 --output dist/matoga-macos-arm64",
    "build:linux": "pkg server/index.js --target node22-linux-x64 --output dist/matoga-linux-x64",
    "build:web": "node scripts/build-web.mjs",
    "electron": "node electron/launch.js",
    "electron:dev": "node electron/launch.js --dev",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "keywords": [
    "folder",
    "compare",
    "diff",
    "texture",
    "material",
    "pbr",
    "web"
  ],
  "author": {
    "name": "芝世 (xiongmiaozai)",
    "email": "2720596091@qq.com"
  },
  "license": "MIT",

  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "assets": [
      "web/**/*",
      "node_modules/three/build/three.module.js",
      "node_modules/three/build/three.core.js",
      "node_modules/golden-layout/dist/esm/**/*",
      "node_modules/golden-layout/dist/css/**/*",
      "node_modules/golden-layout/dist/img/**/*"
    ],
    "targets": [
      "node22-win-x64",
      "node22-macos-arm64",
      "node22-linux-x64"
    ],
    "outputPath": "dist"
  },
  "build": {
    "appId": "com.xiongmiaozai.matoga",
    "productName": "matoga",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "server/**/*",
      "web/**/*",
      "electron/main.js",
      "package.json",
      "!node_modules/three/examples/**/*",
      "!node_modules/three/src/**/*",
      "!node_modules/three/build/three.webgpu.js",
      "!node_modules/three/build/three.webgpu.nodes.js",
      "!node_modules/three/build/three.tsl.js",
      "!node_modules/three/build/three.cjs",
      "!node_modules/golden-layout/src/**/*",
      "!node_modules/golden-layout/dist/cjs/**/*",
      "!node_modules/golden-layout/dist/types/**/*"
    ],
    "extraResources": [
      {
        "from": "hdri-presets",
        "to": "hdri-presets"
      },
      {
        "from": "mc-packs",
        "to": "mc-packs"
      },
      {
        "from": "official-packs",
        "to": "official-packs",
        "filter": [
          "**/*",
          "!**/net/**",
          "!**/com/**",
          "!**/META-INF/**"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@yao-pkg/pkg": "^6.23.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "prettier": "^3.0.0"
  }
}
