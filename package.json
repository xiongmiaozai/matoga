{
  "name": "matoga",
  "version": "3.0.0",
  "description": "材质贴图对比工具 - 本地 Web 服务版（B/S 架构）",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server/index.js",
    "web": "node server/index.js",
    "web:lan": "node server/index.js --lan",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:smoke": "node test/smoke/run.mjs",
    "build:win": "pkg server/index.js --target node22-win-x64 --output dist/matoga-win-x64.exe",
    "build:mac": "pkg server/index.js --target node22-macos-arm64 --output dist/matoga-macos-arm64",
    "build:linux": "pkg server/index.js --target node22-linux-x64 --output dist/matoga-linux-x64",
    "electron": "node electron/launch.js",
    "electron:dev": "node electron/launch.js --dev",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "bb:fetch": "node scripts/fetch-blockbench.mjs --out=data/blockbench-web"
  },
  "keywords": [
    "folder",
    "compare",
    "diff",
    "texture",
    "material",
    "pbr",
    "web"
  ],
  "author": {
    "name": "芝世 (xiongmiaozai)",
    "email": "2720596091@qq.com"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "golden-layout": "^2.6.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=18"
  },
  "pkg": {
    "assets": [
      "web/**/*",
      "node_modules/three/build/three.module.js",
      "node_modules/golden-layout/dist/**/*"
    ],
    "targets": [
      "node22-win-x64",
      "node22-macos-arm64",
      "node22-linux-x64"
    ],
    "outputPath": "dist"
  },
  "build": {
    "appId": "com.xiongmiaozai.matoga",
    "productName": "matoga",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "server/**/*",
      "shared/**/*",
      "web/**/*",
      "electron/main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "hdri-presets",
        "to": "hdri-presets"
      },
      {
        "from": "mc-packs",
        "to": "mc-packs"
      },
      {
        "from": "official-packs",
        "to": "official-packs"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    }
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.23.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  }
}
